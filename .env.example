# .env.example - Symposium Configuration

# Public program, catalog, site, dossiers and local rendering need no API keys.
# Optional standalone bridge (separate InstituteOS SDK and authorized MCP access):
# SUPERHUMAN_DOCS_MCP_TOKEN=your_authorized_mcp_bearer_token

# API Keys for optional paid LLM providers
# Get your keys from:
# - Perplexity: https://www.perplexity.ai/settings/api
# - OpenRouter: https://openrouter.ai/keys

PERPLEXITY_API_KEY=your_perplexity_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: edition and storage roots (paths may be relative to the working directory)
SYMPOSIUM_YEAR=2026
# SYMPOSIUM_DATA_DIR=data
# SYMPOSIUM_OUTPUTS_DIR=outputs
# API_PROVIDER=perplexity
# LOG_LEVEL=INFO

# Model and generation settings belong in config.json; see config.example.json.
